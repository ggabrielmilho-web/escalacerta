# Postgres: banco escala_certa com usuário próprio (escala_app). No servidor o host é o serviço do Postgres no Swarm.
# Local: postgresql://escala_app:<senha>@localhost:5432/escala_certa
DATABASE_URL=postgresql://escala_app:<senha>@postgres:5432/escala_certa
# Credencial da aplicação "Escala Certa" no Mercado Pago (não usar a do DanfeZap)
MP_ACCESS_TOKEN=APP_USR-...
# Endereço público do site, com https em produção (volta do pagamento e aviso do Mercado Pago)
BASE_URL=https://escalacerta.carvalhoia.com
# Assina o cookie de login. Obrigatória em produção. Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PRECO=37.00
NOME_FATURA=ESCALACERTA
# E-mail do "esqueci minha senha" pelo Resend da CarvalhoIA (domínio carvalhoia.com já verificado).
# De preferência uma chave nova só da Escala Certa, criada no painel do Resend (não a do DanfeZap).
RESEND_API_KEY=
EMAIL_REMETENTE=Escala Certa <nao-responda@carvalhoia.com>
# Para onde vai a resposta, se alguém responder o e-mail (opcional)
EMAIL_RESPOSTA=
